<%- include('../partials/admin-header') %>

<h2 class="mb-2">Contact Form Submissions</h2>
<p class="text-muted mb-2">Up to the 200 most recent. Email status reflects whether the SMTP send succeeded.</p>

<% if (submissions.length === 0) { %>
  <div class="card text-center text-muted">No submissions yet.</div>
<% } else { %>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>From</th>
          <th>Email</th>
          <th>Message</th>
          <th>Email Status</th>
        </tr>
      </thead>
      <tbody>
        <% for (const s of submissions) { %>
          <tr>
            <td><%= new Date(s.created_at).toLocaleString() %></td>
            <td><strong><%= s.name %></strong></td>
            <td><a href="mailto:<%= s.email %>"><%= s.email %></a></td>
            <td style="max-width:400px;white-space:pre-wrap;font-size:0.9rem;"><%= s.message %></td>
            <td>
              <% if (s.email_status === 'sent') { %>
                <span class="badge badge-active">Sent</span>
              <% } else if (s.email_status === 'failed') { %>
                <span class="badge badge-inactive" title="<%= s.email_error %>">Failed</span>
                <% if (s.email_error) { %>
                  <div class="text-muted" style="font-size:0.75rem;max-width:200px;"><%= s.email_error.slice(0, 120) %></div>
                <% } %>
              <% } else if (s.email_status === 'skipped') { %>
                <span class="badge badge-inactive" title="<%= s.email_error %>">Skipped</span>
              <% } else { %>
                <span class="badge badge-inactive">Pending</span>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/admin-footer') %>
