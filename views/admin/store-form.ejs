<%- include('../partials/admin-header') %>

<h2 class="mb-2"><%= store ? 'Edit Store' : 'New Store' %></h2>

<div class="card">
  <form method="POST" action="/admin/stores/<%= store ? store.id + '/edit' : 'new' %>" enctype="multipart/form-data">
    <%- include('../partials/csrf') %>
    <div class="form-group">
      <label for="name">Store Name</label>
      <input type="text" name="name" id="name" class="form-control" value="<%= store ? store.name : '' %>" required>
    </div>

    <div class="form-group">
      <label for="slug">URL Slug</label>
      <input type="text" name="slug" id="slug" class="form-control" value="<%= store ? store.slug : '' %>" required
             placeholder="e.g. west-eagles-2026" pattern="[a-z0-9\-]+">
      <small class="text-muted">Lowercase letters, numbers, and dashes only. Store will be at /store/your-slug</small>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea name="description" id="description" class="form-control"><%= store ? store.description : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="image">Store Image</label>
      <input type="file" name="image" id="image" accept="image/*" class="form-control">
      <% if (store && store.image_url) { %>
        <input type="hidden" name="existing_image" value="<%= store.image_url %>">
        <img src="<%= store.image_url %>" alt="" style="max-width:120px;margin-top:8px;border-radius:4px;">
      <% } %>
    </div>

    <div class="form-group">
      <div class="form-check">
        <input type="checkbox" name="active" id="active" <%= store && store.active ? 'checked' : '' %>>
        <label for="active">Active (visible to customers)</label>
      </div>
    </div>

    <hr style="border:none;border-top:1px solid #e0e0e0;margin:24px 0;">
    <h3 class="card-title">Personalization Pricing</h3>
    <p class="text-muted mb-2">Set the upcharge for name and number printing independently. Set to $0.00 if included in base price.</p>

    <div class="form-row">
      <div class="form-group">
        <label for="personalization_name_price">Name Printing ($)</label>
        <input type="number" name="personalization_name_price" id="personalization_name_price" class="form-control"
               step="0.01" min="0" value="<%= store ? parseFloat(store.personalization_name_price).toFixed(2) : '0.00' %>">
      </div>
      <div class="form-group">
        <label for="personalization_number_price">Number Printing ($)</label>
        <input type="number" name="personalization_number_price" id="personalization_number_price" class="form-control"
               step="0.01" min="0" value="<%= store ? parseFloat(store.personalization_number_price).toFixed(2) : '0.00' %>">
      </div>
    </div>

    <hr style="border:none;border-top:1px solid #e0e0e0;margin:24px 0;">
    <h3 class="card-title">Order Deadline</h3>
    <p class="text-muted mb-2">Optional cutoff after which the store stops accepting orders. Leave blank for no deadline.</p>

    <div class="form-row">
      <div class="form-group">
        <label for="orders_close_at">Orders close at (local time)</label>
        <input type="datetime-local" name="orders_close_at" id="orders_close_at" class="form-control"
               value="<%= store && store.orders_close_at ? new Date(store.orders_close_at).toISOString().slice(0, 16) : '' %>">
      </div>
      <div class="form-group" style="flex:2;">
        <label for="order_deadline_message">Message shown after deadline</label>
        <input type="text" name="order_deadline_message" id="order_deadline_message" class="form-control" maxlength="255"
               value="<%= store ? (store.order_deadline_message || '') : '' %>"
               placeholder="e.g. Orders are closed for this campaign. Pickup is Friday.">
      </div>
    </div>

    <hr style="border:none;border-top:1px solid #e0e0e0;margin:24px 0;">
    <h3 class="card-title">Sales Tax</h3>

    <div class="form-group">
      <label for="tax_rate">Tax Rate (%)</label>
      <input type="number" name="tax_rate" id="tax_rate" class="form-control" step="0.01" min="0" max="100"
             value="<%= store ? (parseFloat(store.tax_rate) * 100).toFixed(2) : '6.00' %>" style="max-width:150px;">
      <small class="text-muted">Enter as a percentage (e.g. 6.00 for 6%). Set to 0 for tax-exempt.</small>
    </div>

    <button type="submit" class="btn btn-primary"><%= store ? 'Save Changes' : 'Create Store' %></button>
    <a href="/admin/stores" class="btn btn-secondary">Cancel</a>
  </form>
</div>

<%- include('../partials/admin-footer') %>
