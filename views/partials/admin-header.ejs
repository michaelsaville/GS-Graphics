<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Admin — <%= brand.name %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <meta name="robots" content="noindex">
  <link rel="stylesheet" href="/css/style.css">
  <% if (brand.color) { %>
  <style>:root { --brand-color: <%= brand.color %>; }</style>
  <% } %>
</head>
<body>
  <header class="admin-header">
    <div class="container">
      <h1><a href="/admin" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:inherit;">
        <% if (brand.logoUrl) { %>
          <img src="<%= brand.logoUrl %>" alt="<%= brand.name %>" style="height:32px;max-width:160px;object-fit:contain;">
        <% } %>
        <span><%= brand.name %> Admin</span>
      </a></h1>
      <nav>
        <a href="/admin">Dashboard</a>
        <a href="/admin/stores">Stores</a>
        <a href="/admin/orders">Orders</a>
        <a href="/admin/reports">Reports</a>
        <a href="/admin/contact-submissions">Inbox</a>
        <a href="/admin/defaults">Shop Defaults</a>
        <a href="/admin/settings">Site Settings</a>
        <a href="/" target="_blank">View Site</a>
        <a href="/admin/logout">Logout</a>
      </nav>
    </div>
  </header>
  <main>
    <div class="container">
      <% if (flash) { %>
        <div class="flash flash-<%= flash.type || 'info' %>"><%= flash.message %></div>
      <% } %>
