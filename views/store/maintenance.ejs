<%- include('../partials/header') %>

<div style="max-width:600px;margin:80px auto;text-align:center;">
  <div style="font-size:4rem;line-height:1;margin-bottom:24px;">🛠️</div>
  <h2 class="mb-2">We'll be right back</h2>
  <p class="text-muted" style="font-size:1.1rem;">
    <%= message || "We're briefly offline for updates. Please check back shortly." %>
  </p>
  <% if (site && (site.companyEmail || site.companyPhone)) { %>
    <p class="mt-3 text-muted" style="font-size:0.95rem;">
      Need us in the meantime?
      <% if (site.companyPhone) { %><br>Phone: <a href="tel:<%= site.companyPhone.replace(/[^0-9+]/g, '') %>"><%= site.companyPhone %></a><% } %>
      <% if (site.companyEmail) { %><br>Email: <a href="mailto:<%= site.companyEmail %>"><%= site.companyEmail %></a><% } %>
    </p>
  <% } %>
</div>

<%- include('../partials/footer') %>
